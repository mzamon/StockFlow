@model DashboardVm
@{ViewData["Title"]="Dashboard";}
<div class="page-heading"><div><h1>Good operations start with visibility.</h1><p>Monitor stock health, procurement and sales activity in one place.</p></div><div class="heading-actions"><a class="btn btn-primary" asp-controller="Products" asp-action="Create">Add product</a><a class="btn btn-light" asp-controller="Sales" asp-action="Create">Record sale</a></div></div>
<div class="metric-grid"><article class="metric"><div class="metric-label">Active products <span class="metric-icon blue">▦</span></div><div class="metric-value">@Model.Products.ToString("N0")</div><div class="metric-foot">Items in catalogue</div></article><article class="metric"><div class="metric-label">Inventory value <span class="metric-icon teal">R</span></div><div class="metric-value">@Model.StockValue.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</div><div class="metric-foot">Based on cost price</div></article><article class="metric"><div class="metric-label">Low-stock alerts <span class="metric-icon amber">!</span></div><div class="metric-value">@Model.LowStock</div><div class="metric-foot">At or below reorder level</div></article><article class="metric"><div class="metric-label">Pending approvals <span class="metric-icon violet">↗</span></div><div class="metric-value">@Model.PendingOrders</div><div class="metric-foot">Purchases awaiting review</div></article></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Stock health</h2><p>Items that need attention</p></div><a asp-controller="Products" asp-action="Index" asp-route-lowOnly="true">View inventory</a></div>@if(Model.LowStockItems.Count==0){<div class="empty-state"><strong>Stock levels look healthy</strong><p>No products currently meet their reorder threshold.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Available</th><th>Reorder at</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model.LowStockItems){<tr><td><strong>@p.Name</strong><small>@p.Category</small></td><td>@p.Sku</td><td><strong>@p.QuantityOnHand</strong></td><td>@p.ReorderLevel</td><td><span class="status status-warning">Reorder</span></td></tr>}</tbody></table></div>}</section><section class="panel"><div class="panel-heading"><div><h2>Quick actions</h2><p>Common operational tasks</p></div></div><div class="quick-links"><a asp-controller="Products" asp-action="Create"><span class="quick-icon blue">+</span><span><strong>Add inventory item</strong><small>Create a SKU and set reorder levels</small></span><b>→</b></a><a asp-controller="Purchases" asp-action="Create"><span class="quick-icon teal">PO</span><span><strong>Create purchase order</strong><small>Request stock from a supplier</small></span><b>→</b></a><a asp-controller="Suppliers" asp-action="Create"><span class="quick-icon amber">S</span><span><strong>Add supplier</strong><small>Maintain supplier contacts</small></span><b>→</b></a><a asp-controller="Reports" asp-action="Index"><span class="quick-icon violet">↗</span><span><strong>View reports</strong><small>Review trends and export CSV</small></span><b>→</b></a></div></section><section class="panel wide"><div class="panel-heading"><div><h2>Recent stock movements</h2><p>Traceability across inventory changes</p></div><a asp-controller="Activity" asp-action="Index">Full history</a></div>@if(Model.RecentMovements.Count==0){<div class="empty-state">No stock movements have been recorded.</div>}else{<div class="table-wrap"><table><thead><tr><th>Product</th><th>Movement</th><th>Change</th><th>Balance</th><th>Reference</th><th>Date</th></tr></thead><tbody>@foreach(var m in Model.RecentMovements){<tr><td>@m.Product?.Name</td><td>@m.Type</td><td class="@(m.QuantityChange<0?"negative":"positive")">@(m.QuantityChange>0?"+":"")@m.QuantityChange</td><td>@m.BalanceAfter</td><td>@m.Reference</td><td>@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td></tr>}</tbody></table></div>}</section></div>

@model IEnumerable<Sale>
@{ViewData["Title"]="Sales";}
<div class="page-heading"><div><h1>Sales</h1><p>Record sales and keep inventory balances accurate.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("StockClerk")){<a class="btn btn-primary" asp-action="Create">Record sale</a>}</div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Sale number</th><th>Date</th><th>Customer</th><th>Total</th><th>Recorded by</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.SaleNumber</strong></td><td>@s.SoldAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td>@(s.CustomerName??"Walk-in customer")</td><td><strong>@s.Total.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</strong></td><td>@s.RecordedBy</td></tr>}@if(!Model.Any()){<tr><td colspan="5"><div class="empty-state">No sales recorded yet.</div></td></tr>}</tbody></table></div></section>

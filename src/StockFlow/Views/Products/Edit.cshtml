@model Product
@{ViewData["Title"] = Model.Id==0?"Add product":"Edit product";}
<div class="page-heading">
  <div>
    <h1>@ViewData["Title"]</h1>
    <p>Maintain accurate product details and stock controls.</p>
  </div>
  <a class="btn btn-light" asp-action="Index">Back to inventory</a>
</div>
<section class="panel form-panel">
  <form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="validation">
</div>
    <input asp-for="Id" type="hidden" />
    <div class="form-grid">
      <div>
        <label asp-for="Name">Product name</label>
<input asp-for="Name" />
<span
          asp-validation-for="Name"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="Sku">SKU</label>
<input asp-for="Sku" />
<span
          asp-validation-for="Sku"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="Category">Category</label>
<input asp-for="Category" placeholder="e.g. Electronics" />
<span
          asp-validation-for="Category"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="Barcode">Barcode</label>
<input asp-for="Barcode" />
<span
          asp-validation-for="Barcode"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="CostPrice">Cost price (ZAR)</label>
<input asp-for="CostPrice" type="number" step="0.01" min="0" />
<span
          asp-validation-for="CostPrice"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="SellingPrice">Selling price (ZAR)</label>
<input asp-for="SellingPrice" type="number" step="0.01" min="0" />
<span
          asp-validation-for="SellingPrice"
          class="validation"
        >
</span>
      </div>
      @if(Model.Id==0){
      <div>
        <label asp-for="QuantityOnHand">Opening quantity</label>
<input asp-for="QuantityOnHand" type="number" min="0" />
<span
          asp-validation-for="QuantityOnHand"
          class="validation"
        >
</span>
      </div>
      }else{<input asp-for="QuantityOnHand" type="hidden" />}
      <div>
        <label asp-for="ReorderLevel">Reorder level</label>
<input asp-for="ReorderLevel" type="number" min="0" />
<span
          asp-validation-for="ReorderLevel"
          class="validation"
        >
</span>
      </div>
      <div class="full">
        <label asp-for="Description">Description</label>
<textarea asp-for="Description" rows="3">
</textarea>
      </div>
      <div class="full">
        <label class="check-row"
          >
<input asp-for="IsActive" /> Product is active</label>
      </div>
    </div>
    <div class="form-actions">
      <a class="btn btn-light" asp-action="Index">Cancel</a>
<button class="btn btn-primary" type="submit">Save product</button>
    </div>
  </form>
</section>

@model IEnumerable<Product>
  @{ViewData["Title"]="Reports & exports";}
  <div class="page-heading">
    <div>
      <h1>Reports & exports</h1>
      <p>
        Review inventory value, low-stock risk and recent sales performance.
      </p>
    </div>
    <a class="btn btn-primary" asp-action="ExportProducts"
      >Export product CSV</a
    >
  </div>
  <div class="metric-grid">
    <article class="metric">
      <div class="metric-label">Active products</div>
      <div class="metric-value">@ViewBag.TotalProducts</div>
      <div class="metric-foot">Current catalogue</div>
    </article>
    <article class="metric">
      <div class="metric-label">Stock value</div>
      <div class="metric-value">
        @(((decimal)ViewBag.StockValue).ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-ZA")))
      </div>
      <div class="metric-foot">Cost basis</div>
    </article>
    <article class="metric">
      <div class="metric-label">Low stock</div>
      <div class="metric-value">@ViewBag.LowStock</div>
      <div class="metric-foot">At reorder threshold</div>
    </article>
    <article class="metric">
      <div class="metric-label">Sales in last 30 days</div>
      <div class="metric-value">
        @(((decimal)ViewBag.Sales).ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-ZA")))
      </div>
      <div class="metric-foot">Gross recorded sales</div>
    </article>
  </div>
  <section class="panel">
    <div class="panel-heading">
      <div>
        <h2>Reorder recommendations</h2>
        <p>
          Suggested order quantity is based on the configured reorder threshold.
        </p>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>On hand</th>
            <th>Reorder level</th>
            <th>Suggested quantity</th>
            <th>Estimated cost</th>
          </tr>
        </thead>
        <tbody>
          @foreach(var p in
          Model.Where(p=>p.QuantityOnHand<=p.ReorderLevel)){var
          qty=Math.Max(p.ReorderLevel*2-p.QuantityOnHand,1);
          <tr>
            <td>@p.Name</td>
            <td>@p.Sku</td>
            <td>@p.QuantityOnHand</td>
            <td>@p.ReorderLevel</td>
            <td><strong>@qty</strong></td>
            <td>
              @((qty*p.CostPrice).ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-ZA")))
            </td>
          </tr>
          }@if(!Model.Any(p=>p.QuantityOnHand<=p.ReorderLevel)){
          <tr>
            <td colspan="6">
              <div class="empty-state">
                No reorder recommendations at this time.
              </div>
            </td>
          </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
  <p class="help report-note">
    Demand trends are currently summarised by the sales history and 30-day sales
    total. The suggested quantities are a simple threshold-based recommendation,
    not a statistical forecast.
  </p>
</Product>

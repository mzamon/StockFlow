@model IEnumerable<Supplier>
@{ViewData["Title"]="Suppliers";}
<div class="page-heading">
<div>
<h1>Suppliers</h1>
<p>Keep supplier contact and procurement details up to date.</p>
</div>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Procurement")){<a class="btn btn-primary" asp-action="Create">Add supplier</a>}</div>
<section class="panel">
<form class="filters" method="get">
<input name="q" value="@ViewBag.Query" placeholder="Search supplier or email"/>
<button class="btn btn-primary">Search</button>
</form>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Supplier</th>
<th>Contact</th>
<th>Email</th>
<th>Phone</th>
<th>Address</th>
<th>Status</th>
<th>
</th>
</tr>
</thead>
<tbody>@foreach(var s in Model){<tr>
<td>
<strong>@s.Name</strong>
<small>@s.TaxNumber</small>
</td>
<td>@s.ContactName</td>
<td>@s.Email</td>
<td>@s.Phone</td>
<td>@s.Address</td>
<td>
<span class="status @(s.IsActive?"status-success":"status-muted")">@(s.IsActive?"Active":"Inactive")</span>
</td>
<td>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Procurement")){<a class="btn btn-light btn-small" asp-action="Edit" asp-route-id="@s.Id">Edit</a>}</td>
</tr>}
@if(!Model.Any()){<tr>
<td colspan="7">
<div class="empty-state">No suppliers yet. Add your first supplier.</div>
</td>
</tr>}</tbody>
</table>
</div>
</section>

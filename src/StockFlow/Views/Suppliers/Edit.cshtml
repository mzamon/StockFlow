@model Supplier
@{ViewData["Title"]=Model.Id==0?"Add supplier":"Edit supplier";}
<div class="page-heading">
  <div>
    <h1>@ViewData["Title"]</h1>
    <p>Supplier information is used when creating purchase orders.</p>
  </div>
  <a class="btn btn-light" asp-action="Index">Back to suppliers</a>
</div>
<section class="panel form-panel">
  <form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="validation">
</div>
    <input asp-for="Id" type="hidden" />
    <div class="form-grid">
      <div>
        <label asp-for="Name">Supplier / business name</label>
<input asp-for="Name" />
<span
          asp-validation-for="Name"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="ContactName">Contact person</label>
<input asp-for="ContactName" />
      </div>
      <div>
        <label asp-for="Email">Email</label>
<input asp-for="Email" type="email" />
<span
          asp-validation-for="Email"
          class="validation"
        >
</span>
      </div>
      <div>
<label asp-for="Phone">Phone</label>
<input asp-for="Phone" />
</div>
      <div>
        <label asp-for="TaxNumber">Tax / VAT number</label>
<input asp-for="TaxNumber" />
      </div>
      <div>
        <label class="check-row"
          >
<input asp-for="IsActive" /> Supplier is active</label>
      </div>
      <div class="full">
        <label asp-for="Address">Address</label>
<textarea asp-for="Address" rows="2">
</textarea>
      </div>
    </div>
    <div class="form-actions">
      <a class="btn btn-light" asp-action="Index">Cancel</a>
<button class="btn btn-primary">Save supplier</button>
    </div>
  </form>
</section>

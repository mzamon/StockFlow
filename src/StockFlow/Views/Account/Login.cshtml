@model LoginVm @{ViewData["Title"]="Sign in";}
<div class="auth-wrap">
  <div class="auth-card">
    <span class="eyebrow">WELCOME BACK</span>
    <h1>Sign in to StockFlow</h1>
    <p class="muted">Access your inventory and procurement workspace.</p>
    <form method="post">
      <div asp-validation-summary="ModelOnly" class="validation"></div>
      <label asp-for="Email">Email address</label
      ><input
        asp-for="Email"
        autocomplete="username"
        placeholder="you@company.co.za"
      /><span asp-validation-for="Email" class="validation"></span
      ><label asp-for="Password">Password</label
      ><input asp-for="Password" autocomplete="current-password" /><span
        asp-validation-for="Password"
        class="validation"
      ></span
      ><label class="check-row"
        ><input asp-for="RememberMe" /> Remember me</label
      ><button class="btn btn-primary btn-full" type="submit">Sign in</button>
    </form>
    <p class="auth-note">
      New to StockFlow? <a asp-action="Register">Create an account</a>
    </p>
  </div>
</div>

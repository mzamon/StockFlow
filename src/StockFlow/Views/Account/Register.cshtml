@model RegisterVm
@{ViewData["Title"]="Create account";}
<div class="auth-wrap">
  <div class="auth-card">
    <span class="eyebrow">GET STARTED</span>
    <h1>Create your account</h1>
    <p class="muted">
      Your account starts with an empty workspace. No sample inventory is
      assigned to new accounts.
    </p>
    <form asp-action="Register" method="post">
      <div asp-validation-summary="ModelOnly" class="validation">
</div>
      <label asp-for="FullName">Full name</label>
<input asp-for="FullName" autocomplete="name" />
<span
        asp-validation-for="FullName"
        class="validation"
      >
</span>
<label asp-for="Email">Work email</label>
<input asp-for="Email" autocomplete="email" />
<span
        asp-validation-for="Email"
        class="validation"
      >
</span>
<label asp-for="Password">Password</label>
<input asp-for="Password" autocomplete="new-password" />
<span
        asp-validation-for="Password"
        class="validation"
      >
</span>
<label asp-for="ConfirmPassword">Confirm password</label>
<input asp-for="ConfirmPassword" autocomplete="new-password" />
<span
        asp-validation-for="ConfirmPassword"
        class="validation"
      >
</span>
<button class="btn btn-primary btn-full" type="submit">
        Create account
      </button>
    </form>
    <p class="auth-note">
      Already registered? <a asp-action="Login">Sign in</a>
    </p>
  </div>
</div>

@model IEnumerable<PurchaseOrder>
@{ViewData["Title"]="Purchase orders";}
<div class="page-heading">
<div>
<h1>Purchase orders</h1>
<p>Track supplier orders, approvals and goods received.</p>
</div>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Procurement")){<a class="btn btn-primary" asp-action="Create">Create purchase order</a>}</div>
<section class="panel">
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Order</th>
<th>Supplier</th>
<th>Created</th>
<th>Expected</th>
<th>Status</th>
<th>Created by</th>
<th>Actions</th>
</tr>
</thead>
<tbody>@foreach(var p in Model){<tr>
<td>
<strong>@p.OrderNumber</strong>
<small>@p.Lines.Count line(s)</small>
</td>
<td>@p.Supplier?.Name</td>
<td>@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
<td>@(p.ExpectedAt?.ToString("dd MMM yyyy")??"—")</td>
<td>
<span class="status @(p.Status==PurchaseStatus.PendingApproval?"status-warning":p.Status==PurchaseStatus.Received?"status-success":"status-muted")">@p.Status</span>
</td>
<td>@p.CreatedBy</td>
<td class="actions">@if(p.Status==PurchaseStatus.PendingApproval&&(User.IsInRole("Admin")||User.IsInRole("Manager"))){<a class="btn btn-primary btn-small" asp-action="Approve" asp-route-id="@p.Id">Approve</a>}
@if(p.Status is PurchaseStatus.Ordered or PurchaseStatus.Approved or PurchaseStatus.PartiallyReceived){<a class="btn btn-light btn-small" asp-action="Receive" asp-route-id="@p.Id">Receive stock</a>}</td>
</tr>}
@if(!Model.Any()){<tr>
<td colspan="7">
<div class="empty-state">No purchase orders yet. Create one when you need to replenish stock.</div>
</td>
</tr>}</tbody>
</table>
</div>
</section>

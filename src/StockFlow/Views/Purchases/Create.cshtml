@model CreatePurchaseVm
@{ViewData["Title"]="Create purchase order";}
<div class="page-heading">
  <div>
    <h1>Create purchase order</h1>
    <p>Orders totalling R10,000 or more require manager approval.</p>
  </div>
  <a class="btn btn-light" asp-action="Index">Back to orders</a>
</div>
<section class="panel form-panel">
  <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation">
</div>
    <div class="form-grid">
      <div>
        <label>Supplier</label>
<select asp-for="SupplierId">
          <option value="">Choose supplier</option>
          @foreach(Supplier s in ViewBag.Suppliers){
          <option value="@s.Id">@s.Name</option>
          }
        </select>
      </div>
      <div>
        <label>Product</label>
<select asp-for="ProductId">
          <option value="">Choose product</option>
          @foreach(Product p in ViewBag.Products){
          <option value="@p.Id">@p.Name (@p.Sku)</option>
          }
        </select>
      </div>
      <div>
        <label asp-for="Quantity">Quantity ordered</label>
<input asp-for="Quantity" type="number" min="1" />
<span
          asp-validation-for="Quantity"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="UnitCost">Unit cost (ZAR)</label>
<input asp-for="UnitCost" type="number" min="0" step="0.01" />
<span
          asp-validation-for="UnitCost"
          class="validation"
        >
</span>
      </div>
      <div>
        <label asp-for="ExpectedAt">Expected delivery</label>
<input asp-for="ExpectedAt" type="date" />
      </div>
      <div class="full">
        <label asp-for="Notes">Notes</label>
<textarea asp-for="Notes" rows="3">
</textarea>
      </div>
    </div>
    <div class="form-actions">
      <a class="btn btn-light" asp-action="Index">Cancel</a>
<button class="btn btn-primary">Create order</button>
    </div>
  </form>
</section>
